{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Linux 0.11 - main (QEMU + gdb)",
      "type": "cppdbg",
      "request": "launch",
      "program": "${workspaceFolder}/tools/system",
      "cwd": "${workspaceFolder}",
      "MIMode": "gdb",
      "miDebuggerPath": "/usr/bin/gdb",
      "miDebuggerServerAddress": "localhost:1234",
      "sourceFileMap": {
        "/build": "${workspaceFolder}"
      },
      "stopAtEntry": false,
      "preLaunchTask": "qemu-debug-main",
      "postDebugTask": "qemu-stop",
      "setupCommands": [
        {
          "text": "set architecture i386",
          "ignoreFailures": true
        },
        {
          "text": "set disassembly-flavor intel",
          "ignoreFailures": true
        }
      ],
      "postRemoteConnectCommands": [
        {
          "text": "set architecture i386",
          "ignoreFailures": true
        },
        {
          "text": "hbreak startup_32",
          "ignoreFailures": true
        },
        {
          "text": "hbreak main",
          "ignoreFailures": true
        },
        {
          "text": "continue",
          "ignoreFailures": true
        }
      ]
    }
  ]
}
